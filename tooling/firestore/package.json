{
  "name": "lumen-firestore-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 rules.test.mjs setup_emulator_user.test.mjs",
    "test:emulator": "firebase emulators:exec --project demo-lumen --only firestore --config ../../firebase.json \"npm test\"",
    "test:setup": "node --test setup_emulator_user.test.mjs",
    "test:bootstrap": "node --experimental-vm-modules --test ../../scripts/test_firebase_emulator_bootstrap.mjs ../../scripts/test_portfolio_startup.mjs",
    "setup:emulator-user": "node setup_emulator_user.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "15.32.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "2.11.0"
    },
    "gaxios": {
      "uuid": "11.1.1"
    },
    "re2": "1.27.0"
  }
}
